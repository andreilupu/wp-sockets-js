{
	"name": "@andreilupu/wp-sockets-js",
	"version": "0.1.0-alpha.4",
	"description": "A flexible package for building WordPress Admin Pages using React components",
	"source": "src/index.js",
	"main": "dist/index.js",
	"module": "dist/index.module.js",
	"unpkg": "dist/index.umd.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.module.js",
			"require": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "wp-scripts build",
		"build:package": "microbundle --name WPSockets --jsx React.createElement --external react,react-dom,@wordpress/element,@wordpress/hooks,@wordpress/components,@wordpress/data,@wordpress/compose,@wordpress/i18n,@wordpress/core-data --globals react=React,react-dom=ReactDOM,@wordpress/element=wp.element,@wordpress/hooks=wp.hooks,@wordpress/components=wp.components,@wordpress/data=wp.data,@wordpress/compose=wp.compose,@wordpress/i18n=wp.i18n,@wordpress/core-data=wp.coreData",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"prepare": "npm run build:package",
		"start": "wp-scripts start",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js"
	},
	"devDependencies": {
		"@types/react-dom": "^19.2.3",
		"@wordpress/scripts": "^31.0.0",
		"microbundle": "^0.15.1"
	},
	"peerDependencies": {
		"@wordpress/components": "^30.8.0",
		"@wordpress/compose": "^7.35.0",
		"@wordpress/data": "^10.35.0",
		"@wordpress/element": "^6.35.0"
	},
	"keywords": [
		"wordpress",
		"admin",
		"react",
		"components"
	],
	"author": "Andrei Lupu",
	"license": "GPL-2.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/andreilupu/wp-sockets-js.git"
	},
	"bugs": {
		"url": "https://github.com/andreilupu/wp-sockets-js/issues"
	},
	"homepage": "https://github.com/andreilupu/wp-sockets-js#readme"
}